{# Offer cards; content in _data/offers.json, heading in _data/text/offers.json #}
<section class="section" id="angebote">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="eyebrow">{{ text.offers.eyebrow }}</p>
      <h2>{{ text.offers.title | safe }}</h2>
      <p class="section-lead">{{ text.offers.lead }}</p>
    </header>

    <div class="cards">
      {%- for offer in offers %}
      <article class="card reveal">
        <div class="card-ico" aria-hidden="true">
          {% icon offer.icon, "" %}
        </div>
        <h3>{{ offer.title | safe }}</h3>
        <p>{{ offer.text | safe }}</p>
        <ul class="ticks">
          {%- for feature in offer.features %}
          <li>{{ feature | safe }}</li>
          {%- endfor %}
        </ul>
        <a class="card-link" href="#kontakt" data-interest="{{ offer.title | replace("&shy;", "") }}">{{ text.offers.cta }}<span aria-hidden="true"> →</span></a>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
