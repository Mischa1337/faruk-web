{# Three steps of getting started; texts in _data/text/process.json #}
<section class="section section-alt" id="ablauf">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="eyebrow">{{ text.process.eyebrow }}</p>
      <h2>{{ text.process.title }}</h2>
      <p class="section-lead">{{ text.process.lead }}</p>
    </header>

    <ol class="steps">
      {%- for step in text.process.steps %}
      <li class="step reveal">
        <span class="step-num">0{{ loop.index }}</span>
        <h3>{{ step.title }}</h3>
        {%- for paragraph in step.paragraphs %}
        <p>{{ paragraph }}</p>
        {%- endfor %}
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
