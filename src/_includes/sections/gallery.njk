{#
  Photos from training sessions, all in 4:3 (about 1200 × 900 px), stored
  in src/img/ and listed in _data/text/gallery.json. To add a photo, add an
  entry there – the grid arranges itself. Keep an even number so none
  stands alone in a row. Only use photos the pictured clients have agreed to.
#}
<section class="section" id="einblicke">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="eyebrow">{{ text.gallery.eyebrow }}</p>
      <h2>{{ text.gallery.title }}</h2>
    </header>

    <div class="gallery">
      {%- for photo in text.gallery.photos %}
      <figure class="gallery-item reveal">
        <img src="{{ photo.src }}" loading="lazy" decoding="async"
             sizes="(max-width: 600px) 100vw, (max-width: 1220px) 50vw, 580px"
             alt="{{ photo.alt }}">
        <figcaption>{{ photo.caption }}</figcaption>
      </figure>
      {%- endfor %}
    </div>
  </div>
</section>
