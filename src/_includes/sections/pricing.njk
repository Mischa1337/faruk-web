{# Price cards; prices and features in _data/pricing.json, heading in _data/text/pricing.json #}
<section class="section section-alt" id="preise">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="eyebrow">{{ text.pricing.eyebrow }}</p>
      <h2>{{ text.pricing.title }}</h2>
      <p class="section-lead">{{ text.pricing.lead }}</p>
    </header>

    {#- English writes the euro sign before the amount (€80), German after it (80 €) #}
    {%- set euroBefore = "€" if lang == "en" else "" %}
    {%- set euroAfter = "" if lang == "en" else " €" %}
    <div class="pricing">
      {%- for plan in pricing.plans %}
      <article class="price{% if plan.featured %} price-featured{% endif %} reveal">
        {%- if plan.badge %}
        <p class="badge">{{ plan.badge }}</p>
        {%- endif %}
        <h3>{{ plan.name }}</h3>
        {%- if plan.rates %}
        <dl class="price-rows">
          {%- for rate in plan.rates %}
          <div><dt>{{ rate.duration }}</dt><dd>{{ euroBefore }}<span class="amount">{{ rate.amount }}</span>{{ euroAfter }}</dd></div>
          {%- endfor %}
        </dl>
        {%- else %}
        <p class="price-tag">{%- if euroBefore %}<span class="currency">€</span>{% endif %}<span class="amount">{{ plan.price.amount }}</span><span class="unit">{{ plan.price.unit }}</span></p>
        {%- endif %}
        <p class="price-desc">{{ plan.description }}</p>
        <ul class="ticks">
          {%- for feature in plan.features %}
          <li>{{ feature | safe }}</li>
          {%- endfor %}
        </ul>
        <a class="btn {{ 'btn-primary' if plan.featured else 'btn-ghost' }} btn-block" href="#kontakt" data-interest="{{ plan.name }}">{{ pricing.cta }}</a>
      </article>
      {%- endfor %}
    </div>

    <p class="price-foot reveal">
      {{ pricing.duo.note | fill(pricing.duo) }}<br>
      {{ pricing.nutrition.note | fill(pricing.nutrition) }}<br>
      {{ pricing.footnotes | join("<br>\n      ") | safe }}
    </p>
  </div>
</section>
