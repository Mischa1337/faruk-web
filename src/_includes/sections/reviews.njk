{#
  Real Google reviews, used with the authors' consent; content in
  _data/reviews.json. Update the rating in _data/site.json when new
  reviews come in. The reviews stay in their original German on every
  page – translating them would put words into real people's mouths.
#}
<section class="section section-alt" id="erfolge">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="eyebrow">{{ text.reviews.eyebrow }}</p>
      <h2>{{ text.reviews.title }}</h2>
      <p class="section-lead rating-summary"><span class="stars" aria-hidden="true">★★★★★</span> {{ text.reviews.rating | fill(site.googleReviews) }}</p>
      {%- if text.reviews.languageNote %}
      <p class="reviews-note">{{ text.reviews.languageNote }}</p>
      {%- endif %}
    </header>

    <div class="quotes">
      {%- for review in reviews %}
      <figure class="quote{% if review.featured %} quote-featured{% endif %} reveal">
        <div class="stars" role="img" aria-label="{{ text.reviews.stars }}">★★★★★</div>
        <blockquote{% if lang != "de" %} lang="de"{% endif %}><p>{{ review.text }}</p></blockquote>
        <figcaption><strong>{{ review.author }}</strong><span>{{ text.reviews.source }}</span></figcaption>
      </figure>
      {%- endfor %}
    </div>

    <p class="quotes-more reveal">
      <a class="btn btn-ghost" href="{{ site.googleReviews.url }}" target="_blank" rel="noopener">{{ text.reviews.all }}</a>
    </p>
  </div>
</section>
