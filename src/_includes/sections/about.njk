{# About me; texts in _data/text/about.json #}
<section class="section" id="ueber-mich">
  <div class="wrap about-grid">
    <figure class="about-photo reveal">
      <img src="/img/faruk-palteki-krafttraining-giessen.jpg" loading="lazy" decoding="async"
           sizes="(max-width: 940px) 100vw, 460px"
           alt="{{ text.about.photoAlt }}">
    </figure>

    {#
      Heading and body are separate boxes: on phones the photo moves in
      between them (styles/sections/about.css).
    #}
    <div class="about-copy">
      <header class="about-head reveal">
        <p class="eyebrow">{{ text.about.eyebrow }}</p>
        <h2>{{ text.about.title }}</h2>
      </header>

      <div class="about-body reveal">
        {%- for paragraph in text.about.paragraphs %}
        <p>{{ paragraph | safe }}</p>
        {%- endfor %}

        <ul class="quals">
          {%- for qualification in text.about.qualifications %}
          <li><span>{{ qualification.label | safe }}</span> {{ qualification.value | safe }}</li>
          {%- endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
