{# Cooperation partners; to add a partner, add an entry to _data/partners.json. Heading in _data/text/partners.json #}
<section class="section section-alt" id="kooperationen">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="eyebrow">{{ text.partners.eyebrow }}</p>
      <h2>{{ text.partners.title }}</h2>
      <p class="section-lead">{{ text.partners.lead }}</p>
    </header>

    <div class="partners">
      {%- for partner in partners %}
      <article class="card partner reveal">
        <div class="card-ico" aria-hidden="true">
          {% icon partner.icon, "" %}
        </div>
        {#- A non-breaking space keeps each "·" at the end of a line, never at the start #}
        <p class="partner-kind">{{ partner.kind | escape | replace(" · ", "&nbsp;· ") | safe }}</p>
        <h3>{{ partner.name }}</h3>
        <p>{{ partner.text }}</p>
        <a class="partner-link" href="{{ partner.url }}" target="_blank" rel="noopener">{{ text.partners.link }} {% icon "external" %}<span class="sr-only"> {{ text.ui.newTab }}</span></a>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
