<section class="trustbar" aria-label="{{ text.trustbar.label }}">
  <div class="wrap">
    <div class="trust-grid">
      {%- for item in text.trustbar.items %}
      <div class="trust-item{% if item.textValue %} trust-item-text{% endif %} reveal"><strong>{{ item.value | safe }}</strong><span>{{ item.caption | safe }}</span></div>
      {%- endfor %}
    </div>
  </div>
</section>
