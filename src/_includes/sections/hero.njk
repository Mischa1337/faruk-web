<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      {#
        The small kicker line deliberately sits INSIDE the <h1>: visually it is
        a line above the heading, but for Google it is part of the page's most
        important heading. The slogan alone has no search volume –
        "Personal Training (in Gießen)" and "Online-Coaching" do.
      #}
      <h1>
        <span class="h1-kicker">{{ text.hero.kicker }}</span>
        {{ text.hero.title }}
      </h1>
      <p class="hero-claim">{{ text.hero.claim | safe }}</p>
      <p class="lead">{{ text.hero.lead | safe }}</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="#kontakt">{{ text.hero.cta }}</a>
        <a class="btn btn-ghost btn-lg" href="{{ contactLinks.whatsapp }}" target="_blank" rel="noopener">
          {% icon "whatsapp" %}
          {{ text.hero.whatsapp }}
        </a>
      </div>
      <p class="hero-note">{{ text.hero.note | safe }}</p>
    </div>

    <figure class="hero-photo">
      {#
        fetchpriority="high": this image is the largest element visible on
        load. Google measures exactly its load time (LCP) as a ranking factor.
      #}
      <img src="/img/faruk-personal-trainer-giessen.jpg" fetchpriority="high" decoding="async"
           sizes="(max-width: 940px) 100vw, 480px"
           alt="{{ text.hero.photoAlt }}">
    </figure>
  </div>
</section>
