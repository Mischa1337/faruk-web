{# Contact channels and form; texts in _data/text/contact.json and _data/text/form.json #}
<section class="section" id="kontakt">
  <div class="wrap contact-grid">
    <div class="contact-copy reveal">
      <p class="eyebrow">{{ text.contact.eyebrow }}</p>
      <h2>{{ text.contact.title }}</h2>
      <p class="section-lead">{{ text.contact.lead }}</p>

      <ul class="contact-list">
        <li>
          <a href="{{ contactLinks.whatsapp }}" target="_blank" rel="noopener">
            {% icon "whatsapp" %}
            <span><strong>WhatsApp: {{ site.contact.phoneDisplay }}</strong>{{ text.contact.whatsappHint }} · {{ site.contact.whatsappHours }}</span>
          </a>
        </li>
        <li>
          {#- With a mouse a click copies the address, on touch devices it opens
              the mail app; CSS shows the matching hint (scripts/modules/copy-email.js) #}
          <a href="{{ contactLinks.email }}" class="contact-email" data-copy="{{ site.contact.email }}">
            {% icon "mail" %}
            <span><strong>{{ site.contact.email }}</strong><span class="hint-mail">{{ text.contact.mailHint }}</span><span class="hint-copy" aria-live="polite">{{ text.contact.copyHint }}</span></span>
            {% icon "copy", "ico ico-copy" %}
          </a>
        </li>
        <li>
          <a href="{{ site.contact.instagram.url }}" target="_blank" rel="noopener">
            {% icon "instagram" %}
            <span><strong>{{ site.contact.instagram.handle }}</strong>{{ text.contact.instagramHint }}</span>
          </a>
        </li>
      </ul>

      <p class="contact-area">{{ text.contact.area | safe }}</p>
      {# Same towns as the service area in the Google Business Profile (site.json → serviceArea) #}
      <ul class="service-area" aria-label="{{ text.contact.areaLabel }}">
        {%- for town in site.serviceArea %}
        <li>{{ town }}</li>
        {%- endfor %}
      </ul>
    </div>

    <div class="contact-form-wrap reveal">
      {% include "partials/contact-form.njk" %}
    </div>
  </div>
</section>
