{#
  Contact form. Behaviour (validation, spam protection, sending) lives in
  scripts/modules/contact-form/. Every required field has an error box
  (<p class="error" data-for="…">) that the script fills in. Texts in
  _data/text/form.json; messages written by the script in
  scripts/lib/strings.js.

  data-endpoint: URL of the contact worker (site.contact.formEndpoint). Without
  it the form opens the visitor's mail app instead. The privacy policy
  switches its text on the same value.
#}
<form class="contact-form" id="contactForm" novalidate data-mail="{{ site.contact.email }}"{% if site.contact.formEndpoint %} data-endpoint="{{ site.contact.formEndpoint }}"{% endif %}>
  <p class="form-intro">{{ text.form.intro }}</p>

  <div class="field-row">
    <div class="field">
      <label for="f-name">{{ text.form.name }} <span aria-hidden="true">*</span></label>
      <input type="text" id="f-name" name="name" required maxlength="100" autocomplete="name" placeholder="{{ text.form.namePlaceholder }}" aria-describedby="err-f-name">
      <p class="error" id="err-f-name" data-for="f-name"></p>
    </div>
    <div class="field">
      <label for="f-mail">{{ text.form.email }} <span aria-hidden="true">*</span></label>
      <input type="email" id="f-mail" name="email" required maxlength="254" autocomplete="email" placeholder="{{ text.form.emailPlaceholder }}" aria-describedby="err-f-mail">
      <p class="error" id="err-f-mail" data-for="f-mail"></p>
    </div>
  </div>

  {#- Full width: hint and placeholder are too long for half a row #}
  <div class="field">
    <label for="f-tel">{{ text.form.phone }} <span class="opt">{{ text.form.phoneHint }}</span></label>
    <input type="tel" id="f-tel" name="telefon" maxlength="40" autocomplete="tel" placeholder="{{ text.form.phonePlaceholder }}">
  </div>

  <div class="field">
    <label for="f-source">{{ text.form.source }} <span aria-hidden="true">*</span></label>
    <input type="text" id="f-source" name="quelle" required maxlength="200" aria-describedby="err-f-source">
    <p class="error" id="err-f-source" data-for="f-source"></p>
  </div>

  {#
    Chosen offer: filled in by the offer and price buttons
    (scripts/modules/interest-links.js) and sent as its own field, so the
    message stays free for the visitor's own words.
  #}
  <input type="hidden" id="f-interest" name="interesse">
  {#- Page language: enquiries from the English page are marked as such in the mail #}
  <input type="hidden" name="sprache" value="{{ lang }}">
  <p class="interest-chip" id="interestChip" aria-live="polite" hidden>
    <span>{{ text.form.interest }} <strong id="interestLabel"></strong></span>
    <button type="button" id="interestClear" aria-label="{{ text.form.interestClear }}">{% icon "x" %}</button>
  </p>

  <div class="field">
    <label for="f-msg">{{ text.form.message }} <span aria-hidden="true">*</span></label>
    <textarea id="f-msg" name="nachricht" rows="5" required maxlength="5000" placeholder="{{ text.form.messagePlaceholder }}" aria-describedby="err-f-msg"></textarea>
    <p class="error" id="err-f-msg" data-for="f-msg"></p>
  </div>

  {#
    Spam trap (honeypot). The contact worker checks the field `_gotcha` as
    well, so the trap also works when a bot bypasses the form and posts
    directly to the endpoint (worker/src/handler.js).
  #}
  <div class="hp" aria-hidden="true"><label for="f-hp">{{ text.form.honeypot }}</label><input type="text" id="f-hp" name="_gotcha" tabindex="-1" autocomplete="off"></div>

  <div class="field field-check">
    <input type="checkbox" id="f-consent" name="einwilligung" required aria-describedby="err-f-consent">
    <label for="f-consent">{{ text.form.consent | safe }} <span aria-hidden="true">*</span></label>
    <p class="error" id="err-f-consent" data-for="f-consent"></p>
  </div>

  <button type="submit" class="btn btn-primary btn-block btn-lg" id="submitBtn">{{ text.form.submit }}</button>
  <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
  {#- Shown only when sending fails: opens the mail app with the message already written #}
  <button type="button" class="btn btn-ghost btn-block form-fallback" id="mailFallbackBtn" hidden>{{ text.form.mailFallback }}</button>
</form>

{#- Confirmation after successful sending: replaces the form so it is clear the message is out #}
<div class="form-success" id="formSuccess" hidden>
  <div class="success-ico" aria-hidden="true">
    {% icon "check", "" %}
  </div>
  {#- The script puts ", <first name>" into the span #}
  <h3>{{ text.form.successThanks }}<span id="successName"></span> – {{ text.form.successTitle }}</h3>
  <p>{{ text.form.successText }}</p>
  <p class="success-hint">{{ text.form.successHint }}</p>
  <a class="btn btn-ghost btn-block" href="{{ contactLinks.whatsappAfterForm }}" target="_blank" rel="noopener">
    {% icon "whatsapp" %}
    {{ text.form.whatsapp }}
  </a>
</div>
