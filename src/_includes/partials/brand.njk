{# Logo + word mark + tagline. `brandHref`/`brandLabel` are set by the including header. #}
<a class="brand" href="{{ brandHref }}" aria-label="{{ brandLabel }}">
  <span class="brand-mark" aria-hidden="true"></span>
  <span class="brand-text">{{ site.shortName }}<span class="brand-sub">{{ site.tagline }}</span></span>
</a>
